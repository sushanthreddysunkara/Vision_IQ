# Django
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Existing MySQL database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=vision-iq
MYSQL_SSL=false

# Cloudinary Admin API and server-side uploads (never expose these to Vite)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively, set CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Frontend and backend binding
FRONTEND_URL=http://localhost:5173
HOST=127.0.0.1
PORT=8000

# Optional query and streaming integrations
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
STREAM_INTERVAL=2.5
DATA_DIRECTORY=./data
AI_MODEL_PATH=../AIModel
AI_VEHICLE_MODEL_PATH=../AIModel/nh5_yolov8n_960.pt

# Optional initial administrator accounts; passwords are never logged
ADMIN1_USERNAME=user1
ADMIN1_EMAIL=user1@example.com
ADMIN1_PASSWORD=change_this_password
ADMIN2_USERNAME=user2
ADMIN2_EMAIL=user2@example.com
ADMIN2_PASSWORD=change_this_password
